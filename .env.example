# ===== 环境选择 =====
# default / development / testing / production（服务器上必须为 production）
FLASK_CONFIG=production

# ===== 安全 =====
# JWT / 会话签名密钥，生产环境必须为强随机值
# 生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ===== 数据库 =====
# 不设置则使用 SQLite（data/app.db）
# DATABASE_URL=postgresql://user:pass@localhost:5432/btfit

# ===== CORS =====
# 允许跨域的前端来源，逗号分隔多个；设为 * 允许所有（不建议生产使用）
# 生产环境不设置则不放行任何跨域请求
# CORS_ORIGINS=https://your-frontend.com,https://www.your-frontend.com

# ===== 服务端口（仅开发服务器 python wsgi.py 使用）=====
# PORT=5000
