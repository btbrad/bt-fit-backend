# systemd 服务单元文件
# 使用方式：
#   1. 按服务器实际路径修改下方 WorkingDirectory / ExecStart 中的 /opt/bt-fit-backend
#   2. sudo cp deploy/bt-fit.service /etc/systemd/system/bt-fit.service
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now bt-fit
#   5. 查看日志: journalctl -u bt-fit -f
[Unit]
Description=BT-Fit Backend (gunicorn)
After=network.target

[Service]
# 建议使用非 root 用户运行；如无 www-data 可改为其他低权限用户
User=www-data
Group=www-data
WorkingDirectory=/opt/bt-fit-backend
# 环境变量已写入项目根目录 .env，由 python-dotenv 加载；
# 如不想在服务器上放 .env，也可改用 Environment= 行注入
Environment="FLASK_CONFIG=production"
ExecStart=/opt/bt-fit-backend/venv/bin/gunicorn -w 4 -b 127.0.0.1:8000 wsgi:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
